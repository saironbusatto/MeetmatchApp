# Shared
NODE_ENV=development

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmei
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Universal/App Links (servidos em /.well-known/* pela API)
# APPLE_TEAM_ID: copiar do Apple Developer (Membership → Team ID)
# ANDROID_SHA256_CERT_FINGERPRINT: separar múltiplos por vírgula (debug, dev e prod)
APP_BUNDLE_ID=app.farmei.mobile
APPLE_TEAM_ID=TEAMID
ANDROID_SHA256_CERT_FINGERPRINT=
